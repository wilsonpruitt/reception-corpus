        {"role": "psalm",  "refKey": "Ps.122",               "refDisplay": "Psalm 122"},
        {"role": "second", "refKey": "Rom.13.11-Rom.13.14",  "refDisplay": "Romans 13:11–14"},
        {"role": "gospel", "refKey": "Matt.24.36-Matt.24.44","refDisplay": "Matthew 24:36–44"}
      ]
    },
    {
