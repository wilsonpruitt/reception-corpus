{
  "dataset": "Revised Common Lectionary — spine",
  "description": "Canonical lectionary calendar in the Wroot data-repository standard. Every reading carries an OSIS refKey (KJV/WEB versification) — the universal join into the reception store, Catena, and Lectern's series logic. Citation lists from Vanderbilt (lectionary.library.vanderbilt.edu); refKeys generated by us. RCL cites NRSV versification — refKeys normalized to KJV/WEB; flag divergences per reading.",
  "refKeyScheme": "OSIS osisRef",
  "versification": "KJV/WEB",
  "tracks": "Advent/Christmas/Epiphany/Lent/Easter use a single reading set (track=null). Dual semicontinuous/complementary OT tracks apply only in Season after Pentecost.",
  "occasions": [
    {
      "id": "advent-1-a", "year": "A", "season": "Advent", "name": "First Sunday of Advent",
      "readings": [
