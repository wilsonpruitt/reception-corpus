        {"role": "second", "refKey": "Rom.15.4-Rom.15.13",   "refDisplay": "Romans 15:4–13"},
        {"role": "gospel", "refKey": "Matt.3.1-Matt.3.12",   "refDisplay": "Matthew 3:1–12"}
